{
  "name": "orca-marine-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client:vite": "vite",
    "dev:client": "wait-on tcp:4000 && npm run dev:client:vite",
    "dev:server": "tsx --watch src/server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "lint": "oxlint",
    "test": "tsx src/server/agents/runVerification.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.13",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.35.0",
    "maplibre-gl": "^6.6.0",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.0",
    "ws": "^8.21.3",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.0",
    "oxlint": "^1.79.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
# ─── ORCA Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Mock Data ────────────────────────────────────────────────────────
# Set to 'true' to use mock providers for all data sources.
# Set to 'false' to use real providers (requires API keys below).
USE_MOCK_DATA=false

# ─── JWT ──────────────────────────────────────────────────────────────# Authentication
JWT_SECRET=super_secret_dev_key_only_change_in_production
JWT_EXPIRES_IN=24h

# Feature Flags
USE_MOCK_DATA=false

# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_hBlreA0N1xcI@ep-spring-rice-a5iqdpl2-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379

# ─── Real Data API Keys ───────────────────────────────────────────────
# Phase 6: Fill these in when connecting real data sources.
# Weather: Open-Meteo is free, no key required.
# INCOIS_API_KEY=
# CMEMS_USERNAME=
# CMEMS_PASSWORD=
# IMD_API_KEY=
# MAPTILER_API_KEY=

# ─── LLM Provider ─────────────────────────────────────────────────────
# Phase 5: Uncomment the provider you are using.
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Frontend Origin ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

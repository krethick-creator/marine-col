# ─── ORCA Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Mock Data ────────────────────────────────────────────────────────
# Set to 'true' to use mock providers for all data sources.
# Set to 'false' to use real providers (requires API keys below).
USE_MOCK_DATA=true

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-secret-before-production
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────────────────
# Phase 3: Fill these in when the database is set up.
DATABASE_URL=postgresql://orca:orca@localhost:5432/orca_db
REDIS_URL=redis://localhost:6379

# ─── Real Data API Keys ───────────────────────────────────────────────
# Phase 6: Fill these in when connecting real data sources.
# Weather: Open-Meteo is free, no key required.
# INCOIS_API_KEY=
# CMEMS_USERNAME=
# CMEMS_PASSWORD=
# IMD_API_KEY=
# MAPTILER_API_KEY=

# ─── LLM Provider ─────────────────────────────────────────────────────
# Phase 5: Uncomment the provider you are using.
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Frontend Origin ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

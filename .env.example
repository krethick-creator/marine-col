# ─── ORCA Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── LLM Configuration ───────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK_1=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK_2=qwen/qwen3.6-27b
GROQ_MAX_RETRIES=1
GROQ_REQUEST_TIMEOUT_MS=30000
GROQ_COOLDOWN_MS=60000

# Optional Alternative LLM / API Providers
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Database & Storage ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase / local Postgres with PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/orca_db

# Redis cache connection string (Upstash / local Redis)
REDIS_URL=redis://localhost:6379

# Mock Data toggle (set to true to run without database/external APIs connected)
USE_MOCK_DATA=true

# ─── External Services & APIs ─────────────────────────────────────────
WEATHER_PROVIDER=open-meteo
INCOIS_API_KEY=
CMEMS_USERNAME=
CMEMS_PASSWORD=
MAPTILER_API_KEY=

# ─── Authentication & Security ────────────────────────────────────────
# JWT Secret for signing tokens. Use a strong random string.
JWT_SECRET=super_secret_orca_jwt_key_123
JWT_EXPIRES_IN=7d

# ─── App Server Configuration ─────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Frontend & CORS ──────────────────────────────────────────────────
# Used for CORS configuration
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

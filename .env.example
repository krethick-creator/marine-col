PORT=5000
# Real-time feed
ALERT_LIVE_FEED_ENABLED=true
ALERT_MONITOR_ENABLED=true
ALERT_POLL_INTERVAL_MS=300000
ALERT_FEED_TIMEOUT_MS=8000
ALERT_NOTIFY_ON_STARTUP=false

# Keep these as-is for the dashboard WebSocket
NOTIFY_WEBSOCKET_ENABLED=true
NOTIFY_PUSH_ENABLED=false
NOTIFY_SMS_ENABLED=false
CLIENT_ORIGIN=http://localhost:5173

# Optional push/SMS configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENTS=

# ─── ORCA Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── LLM Providers ────────────────────────────────────────────────────
# ORCA uses Groq for fast, low-latency reasoning.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI configuration (Optional - only if switching providers)
OPENAI_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/orca_db

# ─── Cache / Redis ────────────────────────────────────────────────────
# Redis connection string (Upstash / local Redis)
REDIS_URL=redis://localhost:6379

# ─── Real Data API Keys ───────────────────────────────────────────────
# Phase 6: Fill these in when connecting real data sources.
# Weather: Open-Meteo is free, no key required.
WEATHER_PROVIDER=open-meteo
# INCOIS_API_KEY=
# CMEMS_USERNAME=
# CMEMS_PASSWORD=

# ─── Authentication ───────────────────────────────────────────────────
# JWT Secret for signing tokens. Use a strong random string.
JWT_SECRET=super_secret_orca_jwt_key_123

# ─── App Configuration ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────────────────
# Used for CORS configuration
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

@import "tailwindcss";

/* ─── ORCA Design System ─────────────────────────────────────────────── */

:root {
  --ocean-deep:    #0a1628;
  --ocean-dark:    #0d2040;
  --ocean-mid:     #1a3a6b;
  --ocean-blue:    #1e5fa8;
  --ocean-bright:  #2d8bba;
  --ocean-light:   #7ec8e3;
  --ocean-pale:    #b8dff0;
  --ocean-white:   #e8f4fb;
  --glass-bg:      rgba(255,255,255,0.055);
  --glass-border:  rgba(255,255,255,0.11);
  --glass-hover:   rgba(255,255,255,0.09);
  --sidebar-width: 230px;
}

/* ─── Base Reset ─────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body, #root {
  height: 100%;
  width: 100%;
  overflow: hidden;
}

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--ocean-deep);
  color: var(--ocean-white);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ─── Scrollbar Styling ──────────────────────────────────────────────── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(126,200,227,0.3); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: rgba(126,200,227,0.5); }

/* ─── Glassmorphism Utilities ────────────────────────────────────────── */
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
}

.glass-hover:hover {
  background: var(--glass-hover);
  border-color: rgba(255,255,255,0.18);
  transition: all 0.2s ease;
}

.glass-strong {
  background: rgba(255,255,255,0.09);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  border: 1px solid rgba(255,255,255,0.15);
}

.glass-card {
  background: rgba(13,32,64,0.55);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
}

/* ─── Ocean Background ───────────────────────────────────────────────── */
.ocean-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: linear-gradient(
    175deg,
    #0a1628 0%,
    #0d1f3f 20%,
    #0f2850 40%,
    #0c2244 60%,
    #091930 80%,
    #070f1e 100%
  );
  overflow: hidden;
}

.ocean-bg::before {
  content: '';
  position: absolute;
  inset: -40%;
  background: radial-gradient(ellipse 80% 60% at 30% 60%, rgba(30,95,168,0.18) 0%, transparent 60%),
              radial-gradient(ellipse 60% 40% at 70% 30%, rgba(45,139,186,0.12) 0%, transparent 60%),
              radial-gradient(ellipse 50% 70% at 50% 80%, rgba(10,22,40,0.9) 0%, transparent 60%);
  animation: wave-drift 18s ease-in-out infinite;
}

.ocean-wave {
  position: absolute;
  bottom: 0;
  left: -10%;
  width: 120%;
  pointer-events: none;
}

.ocean-wave svg {
  width: 100%;
  display: block;
}

.wave-layer-1 { animation: wave-float 14s ease-in-out infinite; opacity: 0.12; }
.wave-layer-2 { animation: wave-float 10s ease-in-out infinite reverse; opacity: 0.08; }
.wave-layer-3 { animation: wave-float  7s ease-in-out infinite; opacity: 0.05; }

/* Light beam effect */
.ocean-beam {
  position: absolute;
  top: -20%;
  left: 55%;
  width: 40%;
  height: 120%;
  background: linear-gradient(170deg, rgba(126,200,227,0.04) 0%, transparent 60%);
  transform: rotate(-15deg);
  pointer-events: none;
  animation: beam-drift 20s ease-in-out infinite;
}

@keyframes wave-drift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%       { transform: translate(-2%, 1%) scale(1.01); }
  66%       { transform: translate(2%, -1%) scale(0.99); }
}

@keyframes wave-float {
  0%, 100% { transform: translateX(0) translateY(0); }
  50%       { transform: translateX(2%) translateY(-12px); }
}

@keyframes beam-drift {
  0%, 100% { opacity: 0.6; transform: rotate(-15deg) translateX(0); }
  50%       { opacity: 1;   transform: rotate(-15deg) translateX(3%); }
}

/* ─── Layout ─────────────────────────────────────────────────────────── */
.app-layout {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* ─── Sidebar ────────────────────────────────────────────────────────── */
.sidebar {
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20px 12px;
  gap: 4px;
  position: relative;
  z-index: 10;
  overflow-y: auto;
  overflow-x: hidden;
  background: rgba(8,18,36,0.65);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border-right: 1px solid rgba(255,255,255,0.07);
  flex-shrink: 0;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 8px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  margin-bottom: 8px;
}

.nav-section-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(184,223,240,0.35);
  padding: 8px 10px 4px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.18s ease;
  color: rgba(184,223,240,0.65);
  font-size: 13.5px;
  font-weight: 450;
  letter-spacing: 0.01em;
  text-decoration: none;
  position: relative;
  border: 1px solid transparent;
}

.nav-item:hover {
  background: rgba(45,139,186,0.12);
  color: var(--ocean-white);
  border-color: rgba(45,139,186,0.2);
}

.nav-item.active {
  background: rgba(45,139,186,0.18);
  color: #fff;
  border-color: rgba(45,139,186,0.35);
  font-weight: 500;
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 60%;
  background: linear-gradient(to bottom, var(--ocean-light), var(--ocean-blue));
  border-radius: 0 2px 2px 0;
}

.nav-badge {
  margin-left: auto;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 99px;
  min-width: 16px;
  text-align: center;
  animation: pulse-badge 2s ease-in-out infinite;
}

@keyframes pulse-badge {
  0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }
  50%       { box-shadow: 0 0 0 4px rgba(239,68,68,0); }
}

.sidebar-bottom {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.07);
}

.weather-mini-card {
  background: rgba(30,95,168,0.15);
  border: 1px solid rgba(45,139,186,0.2);
  border-radius: 12px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.offline-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: 10px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
}

.toggle-switch {
  width: 36px;
  height: 20px;
  background: rgba(255,255,255,0.15);
  border-radius: 10px;
  position: relative;
  cursor: pointer;
  transition: background 0.2s;
}

.toggle-switch.on { background: var(--ocean-bright); }

.toggle-switch::after {
  content: '';
  position: absolute;
  top: 3px;
  left: 3px;
  width: 14px;
  height: 14px;
  background: white;
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.toggle-switch.on::after { transform: translateX(16px); }

.user-card {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  border-radius: 10px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  cursor: pointer;
  transition: all 0.18s;
}

.user-card:hover { background: rgba(255,255,255,0.07); }

.avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--ocean-blue), var(--ocean-bright));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

/* ─── Top Bar ────────────────────────────────────────────────────────── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding: 14px 24px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  background: rgba(8,18,36,0.4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  flex-shrink: 0;
}

.top-bar-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 99px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  font-size: 12px;
  font-weight: 500;
  color: var(--ocean-pale);
  cursor: pointer;
  transition: all 0.18s;
}

.top-bar-pill:hover { background: rgba(255,255,255,0.1); }

.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
  animation: live-pulse 2s ease-in-out infinite;
}

@keyframes live-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.5); }
  50%       { box-shadow: 0 0 0 5px rgba(34,197,94,0); }
}

/* ─── Chat Page ──────────────────────────────────────────────────────── */
.chat-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* Hero / empty state */
.chat-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32px;
  padding: 40px 24px;
  animation: fadeIn 0.6s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.hero-logo-icon {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(30,95,168,0.6), rgba(45,139,186,0.6));
  border: 1px solid rgba(126,200,227,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(30,95,168,0.4), 0 0 0 1px rgba(255,255,255,0.1) inset;
  animation: hero-glow 3s ease-in-out infinite;
}

@keyframes hero-glow {
  0%, 100% { box-shadow: 0 8px 32px rgba(30,95,168,0.4), 0 0 0 1px rgba(255,255,255,0.1) inset; }
  50%       { box-shadow: 0 8px 48px rgba(45,139,186,0.6), 0 0 0 1px rgba(255,255,255,0.15) inset; }
}

.hero-title {
  font-family: 'Outfit', sans-serif;
  font-size: 52px;
  font-weight: 700;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #fff 0%, var(--ocean-light) 60%, var(--ocean-pale) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.hero-subtitle {
  font-size: 16px;
  color: rgba(184,223,240,0.7);
  font-weight: 400;
  letter-spacing: 0.01em;
}

/* Suggestion chips */
.suggestion-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  max-width: 680px;
}

.suggestion-chip {
  padding: 9px 16px;
  border-radius: 99px;
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(184,223,240,0.85);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.suggestion-chip:hover {
  background: rgba(45,139,186,0.2);
  border-color: rgba(45,139,186,0.4);
  color: #fff;
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(45,139,186,0.2);
}

/* ─── Chat Input Area ────────────────────────────────────────────────── */
.chat-input-area {
  padding: 16px 24px 20px;
  flex-shrink: 0;
}

.chat-input-wrapper {
  max-width: 760px;
  margin: 0 auto;
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 0;
  background: rgba(13,32,64,0.6);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 18px;
  padding: 10px 10px 10px 16px;
  transition: all 0.25s ease;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.07);
}

.chat-input-wrapper:focus-within {
  border-color: rgba(45,139,186,0.5);
  box-shadow: 0 8px 40px rgba(0,0,0,0.35), 0 0 0 3px rgba(45,139,186,0.12), inset 0 1px 0 rgba(255,255,255,0.08);
}

.chat-textarea {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ocean-white);
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.6;
  resize: none;
  max-height: 160px;
  min-height: 24px;
  padding: 2px 0;
  caret-color: var(--ocean-light);
}

.chat-textarea::placeholder { color: rgba(184,223,240,0.35); }

.chat-input-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.input-action-btn {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: rgba(126,200,227,0.6);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s;
}

.input-action-btn:hover {
  background: rgba(45,139,186,0.15);
  color: var(--ocean-light);
}

.send-btn {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, var(--ocean-blue), var(--ocean-bright));
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  box-shadow: 0 4px 12px rgba(30,95,168,0.4);
  flex-shrink: 0;
}

.send-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(30,95,168,0.6);
}

.send-btn:active { transform: scale(0.97); }

.send-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
}

/* Input meta row */
.chat-input-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 4px 0;
  font-size: 11px;
  color: rgba(126,200,227,0.4);
  max-width: 760px;
  margin: 0 auto;
}

/* ─── Chat Messages ──────────────────────────────────────────────────── */
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.message-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 760px;
  width: 100%;
  margin: 0 auto;
  animation: msg-appear 0.3s ease;
}

@keyframes msg-appear {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.message-group.user { align-items: flex-end; }
.message-group.assistant { align-items: flex-start; }

.message-bubble {
  padding: 12px 16px;
  border-radius: 16px;
  font-size: 14.5px;
  line-height: 1.6;
  max-width: 85%;
}

.message-bubble.user {
  background: linear-gradient(135deg, rgba(30,95,168,0.5), rgba(45,139,186,0.4));
  border: 1px solid rgba(45,139,186,0.3);
  color: #fff;
  border-bottom-right-radius: 4px;
}

.message-bubble.assistant {
  background: rgba(13,32,64,0.6);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--ocean-white);
  border-bottom-left-radius: 4px;
  backdrop-filter: blur(16px);
}

/* ─── Agent Trace ────────────────────────────────────────────────────── */
.agent-trace {
  background: rgba(8,18,36,0.5);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px;
  padding: 14px 16px;
  max-width: 480px;
  backdrop-filter: blur(16px);
}

.agent-trace-title {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(126,200,227,0.6);
  margin-bottom: 10px;
}

.agent-step {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
  font-size: 13px;
  color: rgba(184,223,240,0.5);
  transition: all 0.3s;
}

.agent-step.active { color: var(--ocean-light); }
.agent-step.done   { color: rgba(34,197,94,0.8); }

.agent-step-icon {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 11px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  transition: all 0.3s;
}

.agent-step.active .agent-step-icon {
  background: rgba(45,139,186,0.25);
  border-color: rgba(45,139,186,0.5);
  animation: spin-ring 1s linear infinite;
}

.agent-step.done .agent-step-icon {
  background: rgba(34,197,94,0.15);
  border-color: rgba(34,197,94,0.4);
}

@keyframes spin-ring {
  from { box-shadow: 0 0 0 1.5px transparent, 0 -2px 0 rgba(45,139,186,0.8); }
  to   { box-shadow: 0 0 0 1.5px transparent, 0 2px 0 rgba(45,139,186,0.8); }
}

.agent-connector {
  width: 1px;
  height: 14px;
  background: rgba(255,255,255,0.08);
  margin-left: 10px;
}

/* ─── Recommendation Card ────────────────────────────────────────────── */
.rec-card {
  border-radius: 16px;
  padding: 20px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  max-width: 560px;
}

.rec-card.go {
  background: rgba(34,197,94,0.08);
  border: 1px solid rgba(34,197,94,0.25);
}

.rec-card.caution {
  background: rgba(245,158,11,0.08);
  border: 1px solid rgba(245,158,11,0.25);
}

.rec-card.nogo {
  background: rgba(239,68,68,0.08);
  border: 1px solid rgba(239,68,68,0.25);
}

.rec-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: 99px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.rec-status-badge.go     { background: rgba(34,197,94,0.15);  color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
.rec-status-badge.caution{ background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
.rec-status-badge.nogo   { background: rgba(239,68,68,0.15);  color: #f87171; border: 1px solid rgba(239,68,68,0.3); }

.rec-summary {
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  line-height: 1.5;
  margin-bottom: 16px;
}

.evidence-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 14px;
}

.evidence-item {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px;
  padding: 10px 12px;
}

.evidence-label {
  font-size: 11px;
  color: rgba(126,200,227,0.5);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 3px;
}

.evidence-value {
  font-size: 14px;
  color: var(--ocean-white);
  font-weight: 500;
}

.evidence-meta {
  font-size: 11px;
  color: rgba(126,200,227,0.45);
  margin-top: 1px;
}

.rec-return-time {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: rgba(30,95,168,0.15);
  border: 1px solid rgba(30,95,168,0.3);
  border-radius: 10px;
  margin-bottom: 14px;
  font-size: 13px;
}

.data-freshness {
  border-top: 1px solid rgba(255,255,255,0.07);
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.freshness-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11.5px;
}

.freshness-label { color: rgba(126,200,227,0.5); }
.freshness-value { color: rgba(184,223,240,0.75); font-weight: 500; }

.evidence-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 8px;
  border: 1px solid rgba(45,139,186,0.3);
  background: rgba(45,139,186,0.1);
  color: var(--ocean-light);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.18s;
  margin-top: 12px;
}

.evidence-btn:hover {
  background: rgba(45,139,186,0.2);
  border-color: rgba(45,139,186,0.5);
}

/* ─── Mock Data Banner ───────────────────────────────────────────────── */
.mock-banner {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  background: rgba(245,158,11,0.08);
  border-bottom: 1px solid rgba(245,158,11,0.15);
  font-size: 11px;
  color: rgba(251,191,36,0.8);
  flex-shrink: 0;
}

/* ─── Page Shells ────────────────────────────────────────────────────── */
.page-shell {
  flex: 1;
  overflow-y: auto;
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.page-title {
  font-family: 'Outfit', sans-serif;
  font-size: 28px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.01em;
}

.page-subtitle {
  font-size: 14px;
  color: rgba(184,223,240,0.55);
  margin-top: 4px;
}

/* ─── Status Indicators ──────────────────────────────────────────────── */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 99px;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.status-pill.go      { background: rgba(34,197,94,0.12);  color: #4ade80; border: 1px solid rgba(34,197,94,0.25); }
.status-pill.caution { background: rgba(245,158,11,0.12); color: #fbbf24; border: 1px solid rgba(245,158,11,0.25); }
.status-pill.nogo    { background: rgba(239,68,68,0.12);  color: #f87171; border: 1px solid rgba(239,68,68,0.25); }

/* ─── Shimmer Placeholder ────────────────────────────────────────────── */
.shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8px;
}

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ─── Responsive ─────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  :root { --sidebar-width: 0px; }
  .sidebar { display: none; }
  .chat-input-area { padding: 12px 12px 16px; }
  .chat-messages { padding: 16px 12px; }
  .page-shell { padding: 20px 16px; }
}
